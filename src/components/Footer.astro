---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <!-- Main footer content -->
    <div class="footer-main">
      <div class="footer-grid">
        <!-- Practice Info -->
        <div class="footer-section">
          <div class="footer-brand">
            <img 
              src="/images/logo/1460-dental-logo-white.png" 
              alt="1460 Dental Studio Logo"
              class="footer-logo"
            />
            <h3 class="footer-brand-name">1460 Dental Studio</h3>
            <p class="footer-tagline">Georgetown's Trusted Dentist</p>
          </div>
          
          <p class="footer-description">
            Your trusted Georgetown dentist providing comprehensive dental care for the whole family. 
            We're committed to helping you achieve your healthiest, most confident smile.
          </p>
          
          <!-- Social Media -->
          <div class="footer-social">
            <a href="#" class="social-link" aria-label="Facebook">
              <span class="social-icon">📘</span>
            </a>
            <a href="#" class="social-link" aria-label="Instagram">
              <span class="social-icon">📷</span>
            </a>
            <a href="#" class="social-link" aria-label="Google Reviews">
              <span class="social-icon">⭐</span>
            </a>
          </div>
        </div>
        
        <!-- Quick Links -->
        <div class="footer-section">
          <h4 class="footer-title">Quick Links</h4>
          <ul class="footer-links">
            <li><a href="/" class="footer-link">Home</a></li>
            <li><a href="/about" class="footer-link">About Us</a></li>
            <li><a href="/services" class="footer-link">Our Services</a></li>
            <li><a href="/contact" class="footer-link">Contact</a></li>
            <li><a href="/new-patients" class="footer-link">New Patients</a></li>
          </ul>
        </div>
        
        <!-- Services -->
        <div class="footer-section">
          <h4 class="footer-title">Popular Services</h4>
          <ul class="footer-links">
            <li><a href="/services#general" class="footer-link">General Dentistry</a></li>
            <li><a href="/services#cosmetic" class="footer-link">Cosmetic Dentistry</a></li>
            <li><a href="/services#implants" class="footer-link">Dental Implants</a></li>
            <li><a href="/services#whitening" class="footer-link">Teeth Whitening</a></li>
            <li><a href="/services#emergency" class="footer-link">Emergency Care</a></li>
          </ul>
        </div>
        
        <!-- Contact Info -->
        <div class="footer-section">
          <h4 class="footer-title">Contact Information</h4>
          
          <div class="footer-contact">
            <div class="contact-item">
              <span class="contact-icon">📍</span>
              <div class="contact-info">
                <strong>Address:</strong><br>
                2951 FM1460 #101<br>
                Georgetown, TX 78626
              </div>
            </div>
            
            <div class="contact-item">
              <span class="contact-icon">📞</span>
              <div class="contact-info">
                <strong>Phone:</strong><br>
                <a href="tel:+15127635774">(512) 763-5774</a>
              </div>
            </div>
            
            <div class="contact-item">
              <span class="contact-icon">✉️</span>
              <div class="contact-info">
                <strong>Email:</strong><br>
                <a href="mailto:1460dentalstudio@gmail.com">1460dentalstudio@gmail.com</a>
              </div>
            </div>
          </div>
          
          <!-- Office Hours -->
          <div class="footer-hours">
            <h5 class="hours-title">Office Hours</h5>
            <div class="hours-grid">
              <div class="hours-item">
                <span class="hours-day">Mon - Thu:</span>
                <span class="hours-time">8:00 AM - 4:00 PM</span>
              </div>
              <div class="hours-item">
                <span class="hours-day">Friday:</span>
                <span class="hours-time">Closed</span>
              </div>
              <div class="hours-item">
                <span class="hours-day">Saturday:</span>
                <span class="hours-time">Closed</span>
              </div>
              <div class="hours-item">
                <span class="hours-day">Sunday:</span>
                <span class="hours-time">Closed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Emergency Banner -->
    <div class="footer-emergency">
      <div class="emergency-content">
        <span class="emergency-icon">🚨</span>
        <div class="emergency-text">
          <strong>Dental Emergency?</strong>
          <span>Call our office during business hours</span>
        </div>
        <a href="tel:+15127635774" class="emergency-btn">
          (512) 763-5774
        </a>
      </div>
    </div>
    
    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div class="footer-bottom-content">
        <div class="footer-copyright">
          <p>&copy; {currentYear} 1460 Dental Studio. All rights reserved.</p>
        </div>
        
        <div class="footer-legal">
          <a href="/privacy-policy" class="legal-link">Privacy Policy</a>
          <a href="/terms" class="legal-link">Terms of Service</a>
          <a href="/accessibility" class="legal-link">Accessibility</a>
        </div>
        
        <div class="footer-certifications">
          <span class="cert-item">ADA Member</span>
          <span class="cert-item">Licensed in Texas</span>
        </div>
      </div>
    </div>
  </div>
</footer> 
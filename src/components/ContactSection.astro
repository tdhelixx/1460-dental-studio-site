---
// Contact section component with practice info and CTA
---

<section class="py-24 bg-gradient-to-br from-primary-600 to-primary-800 text-white">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Contact Information -->
      <div>
        <h2 class="text-4xl md:text-5xl font-bold mb-6 editable">
          Ready to Schedule Your Visit?
        </h2>
        
        <p class="text-xl mb-8 text-primary-100 editable">
          Contact us today to schedule your appointment or to learn more about our comprehensive dental services. 
          We're here to help you achieve your healthiest, most confident smile.
        </p>
        
        <!-- Contact Details -->
        <div class="space-y-6 mb-8">
          <!-- Phone -->
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
            </div>
            <div>
              <div class="font-semibold">Call Us</div>
              <a href="tel:+15128639438" class="text-primary-100 hover:text-white transition-colors text-lg">
                (512) 863-9438
              </a>
            </div>
          </div>
          
          <!-- Address -->
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="font-semibold">Visit Us</div>
              <address class="text-primary-100 not-italic">
                1460 Scenic Drive<br>
                Georgetown, TX 78626
              </address>
            </div>
          </div>
          
          <!-- Email -->
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
              </svg>
            </div>
            <div>
              <div class="font-semibold">Email Us</div>
              <a href="mailto:info@1460dentalstudio.com" class="text-primary-100 hover:text-white transition-colors">
                info@1460dentalstudio.com
              </a>
            </div>
          </div>
        </div>
        
        <!-- Office Hours -->
        <div class="card !bg-white/10 backdrop-blur-sm p-6 rounded-lg">
          <h3 class="font-semibold text-lg mb-4">Office Hours</h3>
          <div class="space-y-2 text-primary-100">
            <div class="flex justify-between">
              <span>Monday - Thursday:</span>
              <span>8:00 AM - 5:00 PM</span>
            </div>
            <div class="flex justify-between">
              <span>Friday:</span>
              <span>8:00 AM - 2:00 PM</span>
            </div>
            <div class="flex justify-between">
              <span>Saturday - Sunday:</span>
              <span>Closed</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Call to Action -->
      <div class="text-center lg:text-left">
        <div class="card !bg-white/10 backdrop-blur-sm p-8 rounded-2xl">
          <div class="mb-8">
            <h3 class="text-2xl font-bold mb-4">New Patient Special</h3>
            <p class="text-primary-100 mb-6">
              Comprehensive exam, cleaning, and x-rays for new patients. 
              Take advantage of this limited-time offer to experience our exceptional care.
            </p>
            <div class="text-3xl font-bold text-yellow-400 mb-2">Save $150</div>
            <div class="text-sm text-primary-200">*New patients only. Some restrictions apply.</div>
          </div>
          
          <!-- Action Buttons -->
          <div class="space-y-4">
            <a href="/contact/" class="btn variant-filled-surface w-full text-primary-800 hover:bg-white/90">
              Schedule Online
            </a>
            <a href="tel:+15128639438" class="btn variant-outline w-full border-white text-white hover:bg-white hover:text-primary-800">
              Call Now: (512) 863-9438
            </a>
          </div>
          
          <!-- Trust Indicators -->
          <div class="mt-8 grid grid-cols-2 gap-4 text-center">
            <div>
              <div class="text-2xl font-bold">98%</div>
              <div class="text-sm text-primary-200">Patient Satisfaction</div>
            </div>
            <div>
              <div class="text-2xl font-bold">15+</div>
              <div class="text-sm text-primary-200">Years Experience</div>
            </div>
          </div>
        </div>
        
        <!-- Emergency Contact -->
        <div class="mt-6 text-center">
          <p class="text-primary-200 text-sm mb-2">Dental Emergency?</p>
          <a href="/services/emergencies/" class="text-yellow-400 hover:text-yellow-300 font-semibold">
            Click here for after-hours care
          </a>
        </div>
      </div>
    </div>
  </div>
</section> 
---
// Hero section for dental practice
---

<section class="hero min-h-screen flex items-center relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <svg class="w-full h-full" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
          <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"/>
    </svg>
  </div>
  
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight editable">
          Your Smile is Our <span class="text-primary-200">Priority</span>
        </h1>
        
        <p class="text-xl md:text-2xl mb-8 text-primary-100 font-light editable">
          Experience compassionate, expert dental care in the heart of Georgetown. 
          We're committed to helping you achieve your healthiest, most confident smile.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="/contact/" class="btn-primary text-lg px-8 py-4 inline-block">
            Schedule Your Appointment
          </a>
          <a href="/services/" class="btn-secondary text-lg px-8 py-4 inline-block">
            Explore Our Services
          </a>
        </div>
        
        <!-- Trust indicators -->
        <div class="mt-12 flex flex-col sm:flex-row items-center gap-6 text-primary-100">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>New Patient Special</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"/>
            </svg>
            <span>Insurance Accepted</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <span>Emergency Care</span>
          </div>
        </div>
      </div>
      
      <!-- Image -->
      <div class="relative">
        <div class="card !bg-white/10 backdrop-blur-sm p-8 rounded-2xl">
          <img 
            src="/images/hero-dental-office.jpg" 
            alt="Modern dental office with comfortable seating and advanced technology"
            class="w-full h-96 object-cover rounded-lg shadow-2xl"
            loading="eager"
          />
          
          <!-- Floating stats -->
          <div class="absolute -top-4 -right-4 bg-white text-primary-800 p-6 rounded-xl shadow-lg">
            <div class="text-3xl font-bold">15+</div>
            <div class="text-sm">Years Experience</div>
          </div>
          
          <div class="absolute -bottom-4 -left-4 bg-white text-primary-800 p-6 rounded-xl shadow-lg">
            <div class="text-3xl font-bold">98%</div>
            <div class="text-sm">Patient Satisfaction</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-primary-200 animate-bounce">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section> 
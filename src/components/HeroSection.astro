---
// Hero section for dental practice
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <h1>Welcome to 1460 Dental Studio</h1>
        <p>Your trusted Georgetown dentist providing comprehensive dental care for the whole family.</p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Book Appointment</a>
          <a href="/services" class="btn">Our Services</a>
        </div>
        
        <!-- Trust indicators -->
        <div class="hero-indicators">
          <div class="indicator">
            <span class="indicator-icon">✓</span>
            <span>15+ Years Experience</span>
          </div>
          <div class="indicator">
            <span class="indicator-icon">✓</span>
            <span>Insurance Accepted</span>
          </div>
          <div class="indicator">
            <span class="indicator-icon">✓</span>
            <span>Emergency Care Available</span>
          </div>
        </div>
      </div>
      
      <div class="hero-image">
        <img 
          src="https://images.unsplash.com/photo-1606811971618-4486d14f3f99?w=600&h=450&fit=crop&auto=format" 
          alt="1460 Dental Studio - Georgetown Dentist"
          width="600"
          height="450"
        />
        <!-- Stats overlay -->
        <div class="hero-stat hero-stat-1">
          <div class="stat-number">15+</div>
          <div class="stat-label">Years Experience</div>
        </div>
        <div class="hero-stat hero-stat-2">
          <div class="stat-number">98%</div>
          <div class="stat-label">Patient Satisfaction</div>
        </div>
      </div>
    </div>
  </div>
</section> 
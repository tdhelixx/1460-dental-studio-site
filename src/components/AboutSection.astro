---
// About section component for the dental practice
---

<section class="py-24 bg-surface-100 dark:bg-surface-800">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div>
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-surface-900 dark:text-surface-100 editable">
          Experience You Can Trust
        </h2>
        
        <p class="text-xl text-surface-600 dark:text-surface-400 mb-6 editable">
          At 1460 Dental Studio, we believe in providing personalized, compassionate care 
          that puts our patients first. Our state-of-the-art facility and experienced team 
          are dedicated to helping you achieve optimal oral health.
        </p>
        
        <div class="space-y-4 mb-8">
          <div class="flex items-start space-x-3">
            <svg class="w-6 h-6 text-primary-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="font-semibold text-surface-900 dark:text-surface-100 editable">Advanced Technology</h3>
              <p class="text-surface-600 dark:text-surface-400 editable">
                Latest dental technology for accurate diagnosis and comfortable treatment
              </p>
            </div>
          </div>
          
          <div class="flex items-start space-x-3">
            <svg class="w-6 h-6 text-primary-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="font-semibold text-surface-900 dark:text-surface-100 editable">Experienced Team</h3>
              <p class="text-surface-600 dark:text-surface-400 editable">
                Skilled professionals with years of experience in comprehensive dental care
              </p>
            </div>
          </div>
          
          <div class="flex items-start space-x-3">
            <svg class="w-6 h-6 text-primary-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="font-semibold text-surface-900 dark:text-surface-100 editable">Patient-Centered Care</h3>
              <p class="text-surface-600 dark:text-surface-400 editable">
                Personalized treatment plans tailored to your unique needs and goals
              </p>
            </div>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/about/" class="btn variant-filled-primary">
            Learn More About Us
          </a>
          <a href="/team-members/" class="btn variant-outline-primary">
            Meet Our Team
          </a>
        </div>
      </div>
      
      <!-- Image -->
      <div class="relative">
        <div class="card p-6">
          <img 
            src="/images/about-dental-office.jpg" 
            alt="Modern dental office interior with comfortable patient areas"
            class="w-full h-96 object-cover rounded-lg"
          />
          
          <!-- Stats overlay -->
          <div class="absolute -bottom-6 -left-6 bg-primary-600 text-white p-6 rounded-lg shadow-lg">
            <div class="text-center">
              <div class="text-3xl font-bold">15+</div>
              <div class="text-sm opacity-90">Years Serving Georgetown</div>
            </div>
          </div>
          
          <div class="absolute -top-6 -right-6 bg-white text-primary-800 p-6 rounded-lg shadow-lg">
            <div class="text-center">
              <div class="text-3xl font-bold">2000+</div>
              <div class="text-sm">Happy Patients</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section> 
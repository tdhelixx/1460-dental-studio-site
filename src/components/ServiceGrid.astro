---
// Service grid component featuring popular dental services
const services = [
  {
    title: "Dental Implants",
    description: "Permanent solution for missing teeth with natural-looking results that restore function and confidence.",
    icon: "🦷",
    href: "/services/dental-implants/",
    features: ["Permanent Solution", "Natural Look", "Preserves Bone"]
  },
  {
    title: "Veneers",
    description: "Transform your smile with custom porcelain veneers that create a beautiful, uniform appearance.",
    icon: "✨",
    href: "/services/veneers/",
    features: ["Custom Fit", "Stain Resistant", "Instant Results"]
  },
  {
    title: "Teeth Whitening",
    description: "Professional whitening treatments for a brighter, more confident smile in just one visit.",
    icon: "🌟",
    href: "/services/teeth-whitening/",
    features: ["Fast Results", "Safe Process", "Long Lasting"]
  },
  {
    title: "Invisalign",
    description: "Straighten your teeth discreetly with clear aligners that fit seamlessly into your lifestyle.",
    icon: "🔬",
    href: "/services/invisalign/",
    features: ["Nearly Invisible", "Removable", "Comfortable"]
  },
  {
    title: "Emergency Care",
    description: "Same-day emergency dental care when you need it most, providing immediate relief and treatment.",
    icon: "🚨",
    href: "/services/emergencies/",
    features: ["Same Day Care", "Pain Relief", "Extended Hours"]
  },
  {
    title: "Preventive Care",
    description: "Comprehensive cleanings and preventive treatments to maintain optimal oral health year-round.",
    icon: "🛡️",
    href: "/services/cleaning-hygiene/",
    features: ["Regular Checkups", "Deep Cleaning", "Early Detection"]
  }
];
---

<section class="py-24 bg-surface-50 dark:bg-surface-950">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-surface-900 dark:text-surface-100 editable">
        Comprehensive Dental Services
      </h2>
      <p class="text-xl text-surface-600 dark:text-surface-400 max-w-3xl mx-auto editable">
        From routine cleanings to complex procedures, we provide complete dental care 
        using the latest technology and techniques to ensure your comfort and satisfaction.
      </p>
    </div>
    
    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="service-card group">
          <div class="text-4xl mb-4">{service.icon}</div>
          
          <h3 class="editable">{service.title}</h3>
          
          <p class="editable mb-6">{service.description}</p>
          
          <!-- Features -->
          <div class="mb-6">
            <ul class="space-y-2">
              {service.features.map((feature) => (
                <li class="flex items-center text-sm text-surface-600 dark:text-surface-400">
                  <svg class="w-4 h-4 mr-2 text-primary-600 dark:text-primary-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
          
          <!-- CTA -->
          <div class="mt-auto">
            <a 
              href={service.href}
              class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium group-hover:translate-x-1 transition-transform"
            >
              Learn More
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Call to Action -->
    <div class="text-center mt-16">
      <a href="/services/" class="btn-primary text-lg px-8 py-4 inline-block">
        View All Services
      </a>
    </div>
  </div>
</section> 
---
// Page metadata for CloudCannon  
const title = "About | 1460 Dental Studio";
const description = "Learn more about our experienced Georgetown dental team and commitment to exceptional care. Meet your local smile experts today!";
const hero_headline = "About 1460 Dental Studio";
const hero_tagline = "Your trusted Georgetown dental team providing exceptional care since 2009.";

import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.svelte';
import Footer from '../components/Footer.astro';

// Import global site data
import siteData from '../../data/site.yml';
---

<BaseLayout title={title} description={description}>
  <Navigation client:load />
  
  <main>
    <section class="hero">
      <div class="container">
        <h1>{hero_headline}</h1>
        <p>{hero_tagline}</p>
      </div>
    </section>

    <section class="about-content">
      <div class="container">
        <div class="content-grid">
          <div class="text-content">
            <h2>Welcome to 1460 Dental Studio</h2>
            <p>Located in the heart of Georgetown, Texas, 1460 Dental Studio has been providing exceptional dental care to families since 2009. Our commitment to compassionate, expert dental services has made us a trusted choice for patients seeking quality oral healthcare.</p>
            
            <p>We believe that every patient deserves personalized care in a comfortable, welcoming environment. Our state-of-the-art facility combines the latest dental technology with a warm, family-friendly atmosphere that puts even the most anxious patients at ease.</p>
          </div>
          <div class="image-content">
            <img 
              src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=400&fit=crop&auto=format" 
              alt="1460 Dental Studio Office"
              width="600"
              height="400"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="doctor-info">
      <div class="container">
        <div class="doctor-grid">
          <div class="doctor-content">
            <h2>Meet Dr. Abdallah Ifraitekh</h2>
            <p>Dr. Abdallah Ifraitekh brings over 24 years of dental experience to 1460 Dental Studio. A graduate of Boston University Henry M. Goldman School of Dental Medicine, Dr. Ifraitekh is dedicated to providing the highest quality dental care using the most current techniques and technologies.</p>
            
            <p>His commitment to continuing education ensures that our patients receive the most advanced and effective treatments available. Dr. Ifraitekh takes pride in building long-lasting relationships with his patients, understanding their unique needs, and helping them achieve optimal oral health.</p>
            
            <div class="credentials">
              <h3>Education & Experience</h3>
              <ul>
                <li>Boston University Henry M. Goldman School of Dental Medicine</li>
                <li>24+ years of dental practice experience</li>
                <li>Established 1460 Dental Studio in 2009</li>
                <li>Committed to continuing education and advanced techniques</li>
              </ul>
            </div>
          </div>
          <div class="doctor-image">
            <img 
              src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=300&h=300&fit=crop&auto=format" 
              alt="Dr. Abdallah Ifraitekh - Georgetown Dentist"
              width="300"
              height="300"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="values">
      <div class="container">
        <h2>Our Values</h2>
        <div class="values-grid">
          <div class="value-item">
            <h3>Compassionate Care</h3>
            <p>We treat every patient with kindness, understanding, and respect, ensuring a comfortable experience for all.</p>
          </div>
          <div class="value-item">
            <h3>Expert Treatment</h3>
            <p>Our team uses the latest dental techniques and technology to provide the highest quality care possible.</p>
          </div>
          <div class="value-item">
            <h3>Family-Focused</h3>
            <p>We welcome patients of all ages and strive to be your family's trusted dental home for years to come.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="office-tour">
      <div class="container">
        <div class="tour-content">
          <div class="tour-text">
            <h2>Modern Facility, Comfortable Experience</h2>
            <p>Our Georgetown office features state-of-the-art dental equipment in a warm, welcoming environment. From our comfortable waiting area to our advanced treatment rooms, every detail has been designed with your comfort and care in mind.</p>
            
            <p>We've invested in the latest dental technology to ensure accurate diagnoses and effective treatments, while maintaining the personal touch that makes 1460 Dental Studio special.</p>
          </div>
          <div class="tour-image">
            <img 
              src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=500&h=400&fit=crop&auto=format" 
              alt="1460 Dental Studio Office Interior"
              width="500"
              height="400"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
/* Add styles for the about page content */
.hero {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  padding: 4rem 0;
  text-align: center;
}

.about-content, .doctor-info, .values, .office-tour {
  padding: 4rem 0;
}

.content-grid, .doctor-grid, .tour-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

.values-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.value-item {
  text-align: center;
  padding: 2rem;
  background: #f8fafc;
  border-radius: 0.5rem;
}

.credentials ul {
  list-style: none;
  padding: 0;
}

.credentials li {
  padding: 0.5rem 0;
  border-bottom: 1px solid #e2e8f0;
}

@media (max-width: 768px) {
  .content-grid, .doctor-grid, .tour-content {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  .values-grid {
    grid-template-columns: 1fr;
  }
}
</style> 